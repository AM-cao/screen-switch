<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 登录后运行 screenctl.sh watch；由 mac/install.sh 把 __HOME__ 替换为实际家目录后装到 ~/Library/LaunchAgents。 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.screenctl</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/screenctl/screenctl.sh</string>
		<string>watch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>WorkingDirectory</key>
	<string>__HOME__/screenctl</string>
	<key>StandardOutPath</key>
	<string>__HOME__/screenctl/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/screenctl/launchd.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
